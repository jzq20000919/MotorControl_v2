# The complete motor HMI is constructed from app_main before the backlight is
# enabled. LVGL object/style creation and touch initialization need more than
# the ESP-IDF default 3584-byte main-task stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# DNESP32S3B uses an ESP32-S3 N16R8-compatible module: 8 MB Octal PSRAM.
# Register PSRAM only with the capability allocator so ordinary malloc()
# continues to use internal RAM and test buffers must opt in explicitly.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_MEMTEST=y
