{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build + Flash STM32",
      "type": "shell",
      "command": "cmake --build --preset Release; if ($LASTEXITCODE -eq 0) { STM32_Programmer_CLI.exe -c port=SWD -d build/Release/MCSDK_FOC_v2.hex -rst }",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": [
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-Command"
          ]
        }
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": false
      }
    }
  ]
}